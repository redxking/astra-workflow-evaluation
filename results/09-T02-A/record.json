    "answer": "Implemented all contract validations without mutating inputs. Passed 44 checks and syntax restriction validation.",
    "code": "import hashlib\n\n\ndef verify_snapshot(entries, blobs, per_file_limit, total_limit):\n    if per_file_limit < 0 or total_limit < 0:\n        raise ValueError(\"Negative limit\")\n\n    seen = set()\n    total_bytes = 0\n    for entry in entries:\n        path = entry[\"path\"]\n        if (\n            not path\n            or \"\\\\\" in path\n            or \"\\x00\" in path\n            or any(part in (\"\", \".\", \"..\") for part in path.split(\"/\"))\n        ):\n            raise ValueError(\"Invalid path\")\n        if path in seen:\n            raise ValueError(\"Duplicate path\")\n        seen.add(path)\n\n        size = entry[\"size\"]\n        if size < 0:\n            raise ValueError(\"Negative size\")\n        if path not in blobs:\n            raise ValueError(\"Missing blob\")\n        data = blobs[path]\n        actual_size = len(data)\n        if actual_size != size:\n            raise ValueError(\"Size mismatch\")\n        if actual_size > per_file_limit:\n            raise ValueError(\"Per-file limit exceeded\")\n        total_bytes += actual_size\n        if total_bytes > total_limit:\n            raise ValueError(\"Total limit exceeded\")\n\n        digest = entry[\"sha256\"]\n        if len(digest) != 64 or any(c not in \"0123456789abcdef\" for c in digest):\n            raise ValueError(\"Invalid digest\")\n        if hashlib.sha256(data).hexdigest() != digest:\n            raise ValueError(\"Digest mismatch\")\n\n    return {\"files\": len(entries), \"total_bytes\": total_bytes}\n"
  },
