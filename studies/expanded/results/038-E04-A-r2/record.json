            "input": "text(await tools.exec_command({cmd:\"python3 - <<'PY'\\nimport json\\nwith open('input.json') as f:\\n    d = json.load(f)\\nselected = {}\\nfor r in d['records']:\\n    if r['recorded_at'] <= d['cutoff'] and r['release'] == d['release'] and r['environment'] == d['environment'] and r['status'] in {'PASS', 'FAIL', 'NOT_RUN', 'UNKNOWN'}:\\n        key = (r['observed_at'], r['recorded_at'], r['id'])\\n        old = selected.get(r['gate'])\\n        if old is None or key > (old['observed_at'], old['recorded_at'], old['id']):\\n            selected[r['gate']] = r\\nout = []\\nunknown_findings = []\\nfindings = 0\\nfor g in sorted(d['gates'], key=lambda g: g['id']):\\n    r = selected.get(g['id'])\\n    status = 'UNKNOWN' if r is None or d['cutoff'] - r['observed_at'] > d['max_age'] else r['status']\\n    out.append({'id': g['id'], 'status': status, 'source': None if r is None else r['id']})\\n    if r is None or r.get('findings') is None:\\n        unknown_findings.append(g['id'])\\n    else:\\n        findings += r['findings']\\nstatuses = {g['id']: g['status'] for g in out}\\nblocked = sorted(g['id'] for g in d['gates'] if any(statuses.get(p, 'UNKNOWN') != 'PASS' for p in g['requires']))\\ndecision = 'BLOCKED' if 'FAIL' in statuses.values() else 'INCOMPLETE' if blocked or any(s in {'UNKNOWN', 'NOT_RUN'} for s in statuses.values()) else 'READY'\\nprint(json.dumps({'gates':out, 'decision':decision, 'blocked_dependencies':blocked, 'observed_findings':findings, 'unknown_finding_gates':unknown_findings}, separators=(',', ':')))\\nPY\",\"max_output_tokens\":2000}));\n",
