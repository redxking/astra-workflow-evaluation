            "input": "text(await tools.exec_command({cmd:\"python3 - <<'PY'\\nimport json,itertools\\nwith open('input.json') as f:\\n    d=json.load(f)\\nlat={tuple(sorted((p['a'],p['b']))):p['ms'] for p in d['latencies']}\\nfeasible=[]\\nfor ns in itertools.combinations(sorted(d['nodes'],key=lambda n:n['id']),3):\\n    ids=[n['id'] for n in ns]\\n    cost=sum(n['cost'] for n in ns)\\n    if cost>d['budget'] or any(lat[p]>d['max_pair_latency'] for p in itertools.combinations(ids,2)):\\n        continue\\n    weights=[]\\n    for s in d['failures']:\\n        alive=[n for n in ns if n['site'] not in s['sites'] and n['provider'] not in s['providers']]\\n        weight=sum(n['vote_weight'] for n in alive)\\n        if weight<d['quorum'] or not any(n['writable'] for n in alive):\\n            break\\n        weights.append(weight)\\n    else:\\n        feasible.append({'ids':ids,'cost':cost,'min_weight':min(weights),'scenario_weights':weights})\\nselected=min(feasible,key=lambda p:(p['cost'],-p['min_weight'],p['ids']))\\nprint(json.dumps({'feasible_placements':[p['ids'] for p in feasible],'selected':selected['ids'],'selected_cost':selected['cost'],'selected_min_surviving_weight':selected['min_weight']},separators=(',',':')))\\nprint(json.dumps(feasible,separators=(',',':')))\\nPY\",\"max_output_tokens\":4000}));\n",
