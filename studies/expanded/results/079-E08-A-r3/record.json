            "input": "text(await tools.exec_command({cmd:\"python3 - <<'PY'\\nimport json\\nfrom collections import defaultdict\\nwith open('input.json') as f:\\n    data = json.load(f)\\nadj = defaultdict(list)\\nfor e in data['edges']:\\n    adj[e['source']].append(e)\\nfound = []\\ndef visit(v, seen, arrival, battery, ids, deps, energy):\\n    if v == 'T':\\n        found.append({'selected_edges':ids, 'departures':deps, 'arrival':arrival, 'energy_consumed':energy})\\n        return\\n    if v in data['recharge']:\\n        battery = data['capacity']\\n    for e in adj[v]:\\n        departure = max(arrival, e['open'])\\n        new_arrival = departure + e['duration']\\n        if e['target'] in seen or e['energy'] > battery or departure >= e['close'] or new_arrival > data['deadline']:\\n            continue\\n        visit(e['target'], seen | {e['target']}, new_arrival, battery-e['energy'], ids+[e['id']], deps+[departure], energy+e['energy'])\\nvisit('S', {'S'}, 0, data['capacity'], [], [], 0)\\nfound.sort(key=lambda p: p['selected_edges'])\\nprint(json.dumps({'feasible_paths': found}, indent=2))\\nbest = min(found, key=lambda p: (p['arrival'], p['energy_consumed'], p['selected_edges']))\\nbest['feasible_path_count'] = len(found)\\nprint(json.dumps(best))\\nPY\",\"max_output_tokens\":4000}));\n",
